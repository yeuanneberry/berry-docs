---
import Layout from "./Layout.astro";
import ChapterNav from "../components/ChapterNav.astro";
import Icon from "../components/Icon.astro";
import "../styles/manual-navigation.css";

interface Props {
  current: string;
  headings?: { depth: number; slug: string; text: string }[];
}
const { current, headings = [] } = Astro.props;
const pageId = current === "index" ? "docs-index" : `chapter-${current}`;
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<Layout pageId={pageId}>
  <div class:list={["manual-layout", "shell", { "with-toc": toc.length > 0 }]}>
    <aside class="desktop-chapters"><ChapterNav current={current} /></aside>
    <main id="main-content" tabindex="-1" class="manual-main">
      <details class="mobile-chapters berry-disclosure">
        <summary><span>Browse chapters</span><Icon name="chevron-down" class="disclosure-chevron" /></summary>
        <div class="disclosure-panel"><ChapterNav current={current} /></div>
      </details>
      <slot />
    </main>
    {toc.length > 0 && <aside class="on-this-page">
      <nav aria-label="On this page" data-toc>
        <h2>On this page</h2>
        <ol>{toc.map((heading) => <li class:list={{ "subheading": heading.depth === 3 }}>
          <a href={`#${heading.slug}`} data-toc-link>{heading.text}</a>
        </li>)}</ol>
        <a class="back-to-top" href="#main-content">Back to top <Icon name="arrow-up" /></a>
      </nav>
    </aside>}
  </div>
</Layout>
