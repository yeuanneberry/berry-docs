{
  "name": "berry-docs",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-social-card.mjs && pnpm --filter web dev --host 127.0.0.1",
    "build": "node scripts/generate-social-card.mjs && pnpm --filter web build",
    "check-types": "pnpm --filter web check-types",
    "dev:web": "pnpm --filter web dev",
    "preview": "pnpm --filter web preview --host 127.0.0.1",
    "test": "playwright test",
    "check-reader": "python3 -B scripts/sync-reader.py --verify",
    "check-analytics": "node --test analytics/worker.test.mjs",
    "stats:init:local": "WRANGLER_SEND_METRICS=false wrangler d1 execute STATS_DB --local --file analytics/schema.sql",
    "check-site-builds": "node scripts/generate-social-card.mjs && node scripts/check-site-builds.mjs",
    "check-cloudflare": "node scripts/check-cloudflare-preview.mjs",
    "preview:cloudflare": "WRANGLER_SEND_METRICS=false wrangler dev --local --ip 127.0.0.1 --port 4333",
    "check": "pnpm check-reader && pnpm check-analytics && pnpm check-types && pnpm build && pnpm check-site-builds && pnpm test && pnpm check-cloudflare"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.5.0",
    "@yeuanneberry/config": "workspace:*",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "wrangler": "4.153.0"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@12.11.2"
}
