{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "berry-docs",
  "main": "analytics/worker.mjs",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/stats", "/admin", "/admin/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": { "ANALYTICS_ENABLED": "false", "SITE_URL": "" },
  "d1_databases": [{ "binding": "STATS_DB", "database_name": "berry-docs-stats", "database_id": "00000000-0000-0000-0000-000000000000" }],
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "70103", "simple": { "limit": 600, "period": 60 } },
    { "name": "ADMIN_LIMITER", "namespace_id": "70104", "simple": { "limit": 60, "period": 60 } }
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": false }
}
